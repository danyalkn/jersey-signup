# Shared password that unlocks admin edit-mode for the Lineups tab (create /
# edit / delete / rename lineups). Share with the 2–3 people who plan lineups.
# Validated by /api/auth/check. This is the only environment variable the app
# needs — the roster and existing lineups are hard-coded, and new lineups are
# saved in the browser's localStorage (no database).
ADMIN_PASSWORD=change-me

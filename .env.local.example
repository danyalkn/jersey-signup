NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Shared password that unlocks admin-only mutations (edit/delete jerseys,
# create/edit/delete/rename lineups). Share with the 2–3 people who should
# be able to modify state. Required by /api/edit, /api/notified,
# /api/signups/delete, and all /api/lineups/* routes.
ADMIN_PASSWORD=change-me
